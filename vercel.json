{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "buildCommand": "npm --prefix frontend ci && npm --prefix frontend run build",
  "functions": {
    "backend/main.py": {
      "maxDuration": 300,
      "includeFiles": "{knowledge/**,frontend/dist/**}",
      "excludeFiles": "{frontend/{node_modules,src,e2e}/**,backend/tests/**,**/__pycache__/**,data/**,logs/**,private-backups/**,**/.env*,**/*.env*,**/*.sqlite*,**/*.key}"
    }
  }
}
