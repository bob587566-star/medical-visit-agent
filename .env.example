# 复制为 .env 后本机填写；不要提交密钥
APP_HOST=127.0.0.1
APP_PORT=8270
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
MODEL_TIMEOUT_SECONDS=12
DATA_RETENTION_DAYS=7
LOCAL_SAFETY_ENABLED=false
LOCAL_SAFETY_MODEL=qwen2.5:7b

# 生产基础设施选配，须成对配置；不会自动迁移原SQLite数据
DATABASE_URL=
REDIS_URL=
WORKER_MODE=false
COOKIE_SECURE=false
APP_ALLOWED_HOSTS=127.0.0.1,localhost,testserver,[::1]
# 留空时SQLite使用zhihe_visitor，PostgreSQL使用独立zhihe_visitor_postgres
VISITOR_COOKIE_NAME=
# 密钥文件应由部署系统挂载；默认本机文件只用于开发
MEDICAL_DATA_KEY_FILE=
MEDICAL_TASK_KEY_FILE=
METRICS_TOKEN=
# 只填写经核实的真实公示信息；空值显示未配置
PUBLIC_OPERATOR=
PUBLIC_CONTACT_URL=
PUBLIC_PRIVACY_URL=
PROVIDER_MODEL_FILING_NUMBER=
PROVIDER_MODEL_FILING_URL=
APPLICATION_REGISTRATION_NUMBER=
APPLICATION_REGISTRATION_URL=
ALGORITHM_FILING_NUMBER=
ALGORITHM_FILING_URL=
